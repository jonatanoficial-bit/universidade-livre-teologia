rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function editor() { return role() in ['author', 'reviewer', 'editor', 'admin']; }
    function admin() { return role() == 'admin'; }

    match /courses/{courseId} {
      allow get, list: if resource.data.status == 'published' || editor();
      allow create, update: if editor() && request.resource.data.keys().hasOnly([
        'id','code','title','slug','subtitle','summary','period','tracks','level','hours',
        'status','objectives','updatedAt','version','authors','license','certificate'
      ]);
      allow delete: if admin();
    }
    match /courses/{courseId}/modules/{moduleId} {
      allow get, list: if get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published' || editor();
      allow write: if editor();
    }
    match /courses/{courseId}/lessons/{lessonId} {
      allow get, list: if resource.data.visibility == 'published' || editor();
      allow create, update: if editor() && request.resource.data.keys().hasOnly([
        'id','courseId','moduleId','slug','title','intro','objectives','body','references',
        'minutes','order','visibility','updatedAt','version','video','author','review'
      ]);
      allow delete: if editor();
    }
    match /users/{uid} {
      allow get, update: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && !request.resource.data.keys().hasAny(['role']);
      allow delete: if signedIn() && request.auth.uid == uid;
      match /progress/{lessonId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /notes/{noteId} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /attempts/{attemptId} { allow read, write: if signedIn() && request.auth.uid == uid; }
    }
    match /certificates/{certificateId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false; // only an authenticated server-side endpoint may issue or revoke.
    }
    match /certificateVerification/{token} { allow get: if true; allow list, write: if false; }
    match /settings/{document=**} { allow read: if true; allow write: if admin(); }
  }
}
